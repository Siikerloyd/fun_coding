{
  "name": "momentum",
  "version": "1.0.0",
  "description": "Momentum — a simple desktop focus timer",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "start": "node scripts/run-electron-command.cjs electron-vite preview",
    "dev": "node scripts/run-electron-command.cjs electron-vite dev",
    "build": "node scripts/run-electron-command.cjs electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && node scripts/run-electron-command.cjs electron-builder --dir",
    "build:win": "npm run build && node scripts/run-electron-command.cjs electron-builder --win",
    "build:mac": "npm run build && node scripts/run-electron-command.cjs electron-builder --mac",
    "build:linux": "npm run build && node scripts/run-electron-command.cjs electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@tailwindcss/vite": "^4.1.11",
    "lucide-react": "^1.46.0",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^2.0.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^37.2.3",
    "electron-builder": "^25.1.8",
    "electron-vite": "^4.0.0",
    "eslint": "^9.31.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "prettier": "^3.6.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.0.5"
  }
}
